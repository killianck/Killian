# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# base de données locale (SQLite)
/prisma/*.db
/prisma/*.db-journal
/prisma/migrations/dev.db*

# client Prisma généré (recréé par `npm install` / `npm run db:generate`)
/src/generated
/prisma/generated

# PDF des factures (données sensibles — ne jamais committer)
/uploads/*
!/uploads/.gitkeep

# fichiers de test / exports générés
/exports

# journaux locaux
*.log
dev-server.log
