// Schéma de la base de données (Prisma + SQLite).
// Pour faire évoluer la structure : modifier ce fichier puis lancer `npm run db:migrate`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Une facture (ou un avoir) déposée dans le logiciel.
model Invoice {
  id String @id @default(cuid())

  // --- Nature du document ---
  documentType String @default("facture") // "facture" | "avoir"
  direction    String @default("achat") // "achat" (fournisseur) | "vente" (client)
  category     String? // "materiel" | "sous_traitance" | "transport" | "fournitures" | "services" | "autre" | null

  // --- Relevé de factures ---
  // true = ce document LISTE plusieurs factures (récapitulatif fournisseur) et ne
  // facture rien lui-même. Ses totaux (totalHT/VAT/TTC) portent la part NON encore
  // couverte par des factures saisies séparément ; statementGross* = le cumul imprimé.
  isStatement       Boolean @default(false)
  statementGrossHT  Float?
  statementGrossVAT Float?
  statementGrossTTC Float?

  // --- Identification ---
  number      String?
  invoiceDate DateTime
  dueDate     DateTime? // date d'échéance de paiement (information seule, aucun suivi de paiement)

  // --- Tiers (fournisseur ou client selon `direction`) ---
  // partyName est conservé "à plat" pour l'affichage et comme repli
  // (imports non rattachés) ; partyId pointe vers la fiche Tiers si rattachée.
  partyId      String?
  party        Party?  @relation(fields: [partyId], references: [id])
  partyName    String?
  partyAddress String?
  siret        String?
  vatNumber    String? // TVA intracommunautaire

  currency String @default("EUR")

  // --- Montants globaux (en unité de la devise, ex. euros) ---
  totalHT  Float @default(0)
  totalVAT Float @default(0)
  totalTTC Float @default(0)

  // TVA d'achat récupérable ? (par défaut oui). Mettre à false pour exclure la
  // TVA de cette facture du calcul de la TVA déductible (ex. dépense exclue).
  deductible Boolean @default(true)

  // --- Suivi ---
  status    String @default("a_analyser") // a_analyser | analyse_en_cours | a_verifier | validee | erreur
  coherence String @default("a_verifier") // coherent | a_verifier | incoherent

  // Confiance de la dernière analyse automatique (0..1), null si saisie manuelle.
  confidence Float?

  notes String?

  // --- Fichier PDF original (jamais supprimé automatiquement) ---
  originalFileName String?
  originalFilePath String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vatLines  VatLine[]
  revisions InvoiceRevision[]

  // Lignes du relevé (quand isStatement = true).
  statementLines StatementLine[] @relation("StatementOf")
  // Lignes de relevés qui pointent vers CETTE facture (rapprochement).
  statementRefs  StatementLine[] @relation("MatchedInvoice")

  @@index([invoiceDate])
  @@index([dueDate])
  @@index([direction])
  @@index([status])
  @@index([partyId])
  @@index([isStatement])
}

/// Une ligne du détail d'un relevé de factures : une facture listée, avec son
/// montant, éventuellement rapprochée d'une facture réellement saisie.
model StatementLine {
  id          String  @id @default(cuid())
  statementId String
  statement   Invoice @relation("StatementOf", fields: [statementId], references: [id], onDelete: Cascade)

  reference String // numéro de la facture, tel qu'imprimé sur le relevé
  label     String?
  lineDate  DateTime?
  dueDate   DateTime?
  amountHT  Float?
  amountVAT Float?
  amountTTC Float?

  // Facture saisie séparément qui correspond à cette ligne (null tant qu'absente).
  matchedInvoiceId String?
  matchedInvoice   Invoice? @relation("MatchedInvoice", fields: [matchedInvoiceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([statementId])
  @@index([matchedInvoiceId])
  @@index([reference])
}

/// Fiche d'un tiers (fournisseur et/ou client), réutilisable d'une facture à l'autre.
model Party {
  id        String  @id @default(cuid())
  kind      String  @default("les_deux") // "fournisseur" | "client" | "les_deux"
  name      String
  address   String?
  siret     String?
  vatNumber String?
  email     String?
  phone     String?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]

  @@index([name])
}

/// Une ligne de TVA d'une facture. Une facture peut en avoir plusieurs (plusieurs taux).
model VatLine {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  rate      Float // taux en pourcentage : 20, 10, 5.5, 2.1, 0
  baseHT    Float // montant HT soumis à ce taux
  vatAmount Float // montant de TVA pour ce taux

  @@index([invoiceId])
}

/// Journal des modifications manuelles apportées à une facture.
model InvoiceRevision {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  changedAt DateTime @default(now())
  field     String
  oldValue  String?
  newValue  String?
  userName  String? // qui a fait la modification (nom de l'utilisateur connecté)

  @@index([invoiceId])
}

/// Compte utilisateur de l'application.
model User {
  id           String   @id @default(cuid())
  name         String   @unique
  passwordHash String
  role         String   @default("standard") // "admin" | "standard"
  createdAt    DateTime @default(now())
  lastLoginAt  DateTime?
}
