# Copiez ce fichier en ".env" puis adaptez les valeurs si besoin.
# Ne JAMAIS committer le fichier ".env" (il est ignoré par Git).

# --- Emplacement des données ---
# Les données (base + PDF + sauvegardes) sont stockées à part du code, dans un
# dossier "data". Par défaut : <projet>/data (bien pour le développement).
#
# Pour l'application installée sur Windows, l'installeur/le lanceur définit
# APP_DATA_DIR vers le dossier de données de l'utilisateur, par exemple :
#   APP_DATA_DIR="C:/Users/moi/AppData/Roaming/FacturationTVA"
# et DATABASE_URL vers le fichier de base correspondant :
#   DATABASE_URL="file:C:/Users/moi/AppData/Roaming/FacturationTVA/facturation.db"
APP_DATA_DIR=""

# Base de données SQLite. Chemin relatif = relatif au dossier "prisma/".
DATABASE_URL="file:../data/facturation.db"

# Dossier des PDF de factures. Vide = <data>/factures-pdf. Sinon : chemin ABSOLU.
UPLOAD_DIR=""

# --- Analyse automatique des factures ---
#   "heuristic" (défaut) : lit le texte du PDF et repère les infos courantes
#   "stub"               : n'analyse rien (saisie 100 % manuelle)
#   plus tard : "openai", "mistral", "azure-document-intelligence", etc.
INVOICE_PARSER="heuristic"

# Clé API du service d'analyse (À NE JAMAIS mettre dans le code source).
# Exemple : INVOICE_PARSER_API_KEY="sk-..."
INVOICE_PARSER_API_KEY=""

# Clé de signature des sessions (connexion). Générez-en une avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# L'application installée en génère une automatiquement.
AUTH_SECRET=""
